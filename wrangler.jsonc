{
  "name": "app",
  "main": "push/worker.mjs",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public-build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/push/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH",
        "class_name": "PushDevice"
      }
    ]
  },
  "migrations": [
    {
      "tag": "kese-push-v1",
      "new_sqlite_classes": [
        "PushDevice"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "PUSH_LIMIT",
      "namespace_id": "1029",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "VAPID_SUBJECT": "https://app.kese.workers.dev/privacy.html"
  },
  "build": {
    "command": "node scripts/build-assets.mjs"
  }
}
